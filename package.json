{
  "name": "kiosk-manager",
  "version": "1.0.0",
  "description": "Multi-platform kiosk system for schools",
  "main": "dist/main.js",
  "scripts": {
    "rebuild": "node-gyp rebuild",
    "build": "npx tsc && npm run copy-renderer",
    "copy-renderer": "node -e \"require('fs').cpSync('src/renderer', 'renderer', {recursive: true})\"",
    "start": "npm run build && electron .",
    "dev": "npx tsc && npm run copy-renderer && electron .",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win"
  },
  "keywords": [
    "kiosk",
    "electron",
    "school"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "node-gyp": "^10.0.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "socket.io-client": "^4.6.1",
    "dotenv": "^16.3.1"
  },
  "build": {
    "appId": "com.school.kiosk",
    "productName": "Kiosk Manager",
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "extendInfo": {
        "LSUIElement": 0
      }
    },
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "scripts/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}